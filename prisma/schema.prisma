// Alpha Tech E-Commerce & Engineering Platform - Production Prisma Schema
// Target Database: PostgreSQL
// ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. ENUMS
// ==========================================

enum Role {
  SUPER_ADMIN
  SHOP_MANAGER
  CAD_PRINT_ENGINEER
  CUSTOMER
}

enum ProductType {
  PHYSICAL
  SERVICE
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  PRE_ORDER
  OUT_OF_STOCK
}

enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
  RESERVATION
  RELEASE
  ADJUSTMENT
  RETURN
  ORDER_DEDUCTION
}

enum OrderType {
  PRODUCT
  CUSTOM_SERVICE
  THREE_D_PRINTING
  CAD
  ENGINEERING
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_UNVERIFIED
  PAYMENT_VERIFIED
  PROCESSING
  IN_PRODUCTION
  READY_FOR_DISPATCH
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  JAZZCASH
  EASYPAISA
  CARD
}

enum PaymentStatus {
  PENDING
  UNVERIFIED
  VERIFIED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuoteStatus {
  QUOTE_REQUESTED
  PENDING_ADMIN_REVIEW
  UNDER_REVIEW
  QUOTE_SENT
  PAYMENT_PENDING
  PAID
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

enum CourierCode {
  TCS
  LEOPARD
  M_AND_P
  TRAX
}

enum ShipmentStatus {
  DRAFT
  BOOKED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  FAILED_DELIVERY
}

enum NotificationType {
  NEW_ORDER
  NEW_QUOTE
  PAYMENT_PROOF_UPLOADED
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  LOW_STOCK
  ORDER_SHIPPED
  QUOTE_SENT
  QUOTE_ACCEPTED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
}

// ==========================================
// 2. CORE USER & ACCESS MANAGEMENT
// ==========================================

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  phone         String?
  passwordHash  String?
  firstName     String
  lastName      String
  role          Role           @default(CUSTOMER)
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  addresses     Address[]
  orders        Order[]
  quotes        QuoteRequest[]
  carts         Cart[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([isActive])
}

// ==========================================
// 3. ADDRESS MODEL
// ==========================================

model Address {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  phone        String
  province     String
  city         String
  area         String?
  addressLine1 String
  addressLine2 String?
  postalCode   String
  country      String   @default("Pakistan")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([city])
}

// ==========================================
// 4. PRODUCT CATALOG & TAXONOMY
// ==========================================

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  image       String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products    Product[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive])
}

model Product {
  id                      String             @id @default(uuid())
  categoryId              String
  category                Category           @relation(fields: [categoryId], references: [id])
  name                    String
  slug                    String             @unique
  sku                     String             @unique
  description             String
  shortDescription        String
  brand                   String             @default("Alpha Tech")
  productType             ProductType        @default(PHYSICAL)
  basePrice               Decimal            @db.Decimal(12, 2)
  currency                String             @default("PKR")
  status                  StockStatus        @default(IN_STOCK)
  stockMode               String             @default("PRODUCT_TRACKED") // "PRODUCT_TRACKED" | "VARIANT_TRACKED"
  allowBackorder          Boolean            @default(false)
  lowStockThreshold       Int                @default(5)
  isFeatured              Boolean            @default(false)
  isActive                Boolean            @default(true)
  technicalSpecifications Json               // Structured category-specific attributes
  compatibilityNotes      String?
  shippingNotes           String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  variants                ProductVariant[]
  images                  ProductImage[]
  inventory               Inventory?
  inventoryTransactions   InventoryTransaction[]
  cartItems               CartItem[]
  orderItems              OrderItem[]

  @@index([categoryId])
  @@index([slug])
  @@index([sku])
  @@index([status])
  @@index([isFeatured])
  @@index([isActive])
}

model ProductVariant {
  id                    String                 @id @default(uuid())
  productId             String
  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                   String                 @unique
  name                  String                 // e.g., "1.5mm Thickness", "4mm Thickness", "5mm Thickness"
  price                 Decimal                @db.Decimal(12, 2)
  currency              String                 @default("PKR")
  weight                Decimal?               @db.Decimal(8, 3) // in kg
  dimensions            Json?                  // length, width, height in mm
  attributes            Json                   // variant attributes key-value map
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  images                ProductImage[]
  inventory             Inventory?
  inventoryTransactions InventoryTransaction[]
  cartItems             CartItem[]
  orderItems            OrderItem[]

  @@index([productId])
  @@index([sku])
  @@index([isActive])
}

model ProductImage {
  id           String          @id @default(uuid())
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  url          String
  alt          String
  sortOrder    Int             @default(0)
  isPrimary    Boolean         @default(false)
  createdAt    DateTime        @default(now())

  @@index([productId])
  @@index([variantId])
}

// ==========================================
// 5. INVENTORY MANAGEMENT
// ==========================================

model Inventory {
  id                String          @id @default(uuid())
  productId         String          @unique
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?         @unique
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity          Int             @default(0)
  reservedQuantity  Int             @default(0)
  lowStockThreshold Int             @default(5)
  allowBackorder    Boolean         @default(false)
  updatedAt         DateTime        @updatedAt

  @@index([productId])
  @@index([variantId])
}

model InventoryTransaction {
  id               String                   @id @default(uuid())
  productId        String
  product          Product                  @relation(fields: [productId], references: [id])
  variantId        String?
  variant          ProductVariant?          @relation(fields: [variantId], references: [id])
  type             InventoryTransactionType
  quantityChange   Int                      // Signed integer
  resultingBalance Int
  reason           String                   // e.g. "Order Reservation", "Manual Restock", "Cycle Count"
  referenceType    String?                  // "ORDER", "RETURN", "MANUAL", "DAMAGE"
  referenceId      String?                  // Associated Order ID or audit reference
  performedBy      String?                  // User ID or Staff Name
  createdAt        DateTime                 @default(now())

  @@index([productId])
  @@index([variantId])
  @@index([type])
  @@index([createdAt])
}

// ==========================================
// 6. CART SYSTEM
// ==========================================

model Cart {
  id        String     @id @default(uuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?    @unique
  status    String     @default("ACTIVE") // "ACTIVE" | "ABANDONED" | "CONVERTED"
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items     CartItem[]

  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id               String          @id @default(uuid())
  cartId           String
  cart             Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  quantity         Int             @default(1)
  unitPrice        Decimal         @db.Decimal(12, 2)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([productVariantId])
}

// ==========================================
// 7. ORDER MANAGEMENT
// ==========================================

model Order {
  id                      String               @id @default(uuid())
  orderNumber             String               @unique
  userId                  String?
  user                    User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  email                   String
  phone                   String
  orderType               OrderType            @default(PRODUCT)
  status                  OrderStatus          @default(PENDING_PAYMENT)
  paymentStatus           PaymentStatus        @default(PENDING)
  fulfillmentStatus       String               @default("UNFULFILLED")
  currency                String               @default("PKR")
  subtotal                Decimal              @db.Decimal(12, 2)
  shippingAmount          Decimal              @db.Decimal(12, 2)
  discountAmount          Decimal              @default(0) @db.Decimal(12, 2)
  taxAmount               Decimal              @default(0) @db.Decimal(12, 2)
  total                   Decimal              @db.Decimal(12, 2)
  shippingAddressSnapshot Json                 // Full immutable address snapshot at purchase time
  notes                   String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  items                   OrderItem[]
  statusHistory           OrderStatusHistory[]
  payments                Payment[]
  shipments               Shipment[]

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id                String          @id @default(uuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quoteId           String?
  quote             QuoteRequest?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  productName       String          // Snapshot
  variantName       String?         // Snapshot
  sku               String          // Snapshot
  quantity          Int
  unitPrice         Decimal         @db.Decimal(12, 2)
  total             Decimal         @db.Decimal(12, 2)
  technicalSnapshot Json?           // Snapshot of technical parameters / tolerances / specs

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderStatusHistory {
  id             String       @id @default(uuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousStatus OrderStatus?
  newStatus      OrderStatus
  changedBy      String?      // Staff identifier or "SYSTEM" / "CUSTOMER"
  note           String?
  createdAt      DateTime     @default(now())

  @@index([orderId])
  @@index([createdAt])
}

// ==========================================
// 8. PAYMENT & VERIFICATION
// ==========================================

model Payment {
  id                   String               @id @default(uuid())
  orderId              String
  order                Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method               PaymentMethod
  amount               Decimal              @db.Decimal(12, 2)
  currency             String               @default("PKR")
  status               PaymentStatus        @default(PENDING)
  transactionReference String?
  provider             String?              // "MEEZAN_BANK", "JAZZCASH_PG", "MANUAL_TRANSFER"
  providerTransactionId String?
  receiptAttachmentKey String?              // Private secure storage key for bank deposit slip
  verifiedBy           String?
  verifiedAt           DateTime?
  failureReason        String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  verification         PaymentVerification?

  @@index([orderId])
  @@index([status])
  @@index([method])
  @@index([transactionReference])
}

model PaymentVerification {
  id                   String             @id @default(uuid())
  paymentId            String             @unique
  payment              Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  transactionReference String
  bankName             String?
  receiptAttachmentKey String?
  status               VerificationStatus @default(PENDING)
  verifiedByUserId     String?
  verifiedAt           DateTime?
  rejectionReason      String?
  notes                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status])
  @@index([transactionReference])
}

// ==========================================
// 9. ENGINEERING SERVICES & QUOTES
// ==========================================

model Service {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String
  serviceType String   // "3D_PRINTING", "CAD_DESIGN", "REVERSE_ENGINEERING", etc.
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotes      QuoteRequest[]

  @@index([slug])
  @@index([isActive])
}

model QuoteRequest {
  id                           String               @id @default(uuid())
  quoteNumber                  String               @unique
  userId                       String?
  user                         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  serviceId                    String?
  service                      Service?             @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  customerName                 String
  customerEmail                String
  customerPhone                String
  customerWhatsApp             String
  companyName                  String?
  serviceType                  String               // Fallback string/code
  projectDescription           String
  quantity                     Int                  @default(1)
  requestedDeadline            String?
  application                  String?
  material                     String?
  layerHeight                  String?
  infill                       String?
  surfaceFinish                String?
  loadRequirements             String?
  thermalRequirements          String?
  tolerance                    String?
  dimensions                   String?
  additionalRequirements       String?
  ndaRequested                 Boolean              @default(false)
  ndaStatus                    String               @default("NOT_REQUIRED")
  status                       QuoteStatus          @default(QUOTE_REQUESTED)
  assignedEngineer             String?
  estimatedWeight              Decimal?             @db.Decimal(8, 3) // in kg
  estimatedMachineRuntimeHours Decimal?             @db.Decimal(8, 2)
  estimatedMaterialCost        Decimal?             @db.Decimal(12, 2)
  estimatedLaborHours          Decimal?             @db.Decimal(8, 2)
  additionalCost               Decimal?             @db.Decimal(12, 2)
  quotedSubtotal               Decimal?             @db.Decimal(12, 2)
  quotedPrice                  Decimal?             @db.Decimal(12, 2)
  currency                     String               @default("PKR")
  validUntil                   DateTime?
  internalNotes                String?
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt

  files                        QuoteFile[]
  items                        QuoteItem[]
  history                      QuoteStatusHistory[]
  orderItems                   OrderItem[]

  @@index([quoteNumber])
  @@index([userId])
  @@index([status])
  @@index([serviceId])
  @@index([createdAt])
}

model QuoteFile {
  id               String       @id @default(uuid())
  quoteRequestId   String
  quoteRequest     QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  originalFileName String
  fileSizeBytes    BigInt
  format           String       // .STL, .OBJ, .STEP, .SLDPRT, .DXF
  storageKey       String       // Secure private bucket key, strictly non-public
  mimeType         String?      @default("application/octet-stream")
  checksum         String?
  uploadedBy       String?
  createdAt        DateTime     @default(now())

  @@index([quoteRequestId])
  @@index([storageKey])
}

model QuoteItem {
  id             String       @id @default(uuid())
  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int          @default(1)
  unitPrice      Decimal      @db.Decimal(12, 2)
  total          Decimal      @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())

  @@index([quoteRequestId])
}

model QuoteStatusHistory {
  id             String       @id @default(uuid())
  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  previousStatus QuoteStatus?
  newStatus      QuoteStatus
  note           String?
  changedBy      String?      // Staff or Customer
  createdAt      DateTime     @default(now())

  @@index([quoteRequestId])
  @@index([createdAt])
}

// ==========================================
// 10. SHIPPING & COURIER LOGISTICS
// ==========================================

model Courier {
  id                  String           @id @default(uuid())
  code                CourierCode      @unique
  name                String
  trackingUrlTemplate String?
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  shipments           Shipment[]

  @@index([code])
  @@index([isActive])
}

model Shipment {
  id                 String                  @id @default(uuid())
  orderId            String
  order              Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courierId          String?
  courier            Courier?                @relation(fields: [courierId], references: [id])
  courierCode        CourierCode             @default(TCS)
  consignmentNumber  String?
  trackingNumber     String?
  labelReference     String?                 // Private storage key for shipping label PDF
  status             ShipmentStatus          @default(DRAFT)
  originCity         String                  @default("Lahore")
  destinationCity    String
  recipientName      String
  recipientPhone     String
  recipientAddress   String
  weightKg           Decimal                 @db.Decimal(8, 3)
  codAmount          Decimal                 @default(0) @db.Decimal(12, 2)
  shippingCost       Decimal                 @default(0) @db.Decimal(12, 2)
  currency           String                  @default("PKR")
  shippedAt          DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  trackingEvents     ShipmentTrackingEvent[]

  @@index([orderId])
  @@index([courierId])
  @@index([trackingNumber])
  @@index([consignmentNumber])
  @@index([status])
}

model ShipmentTrackingEvent {
  id         String         @id @default(uuid())
  shipmentId String
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     ShipmentStatus
  location   String
  message    String
  timestamp  DateTime       @default(now())

  @@index([shipmentId])
  @@index([timestamp])
}

// ==========================================
// 11. NOTIFICATIONS & AUDIT TRAIL
// ==========================================

model Notification {
  id        String              @id @default(uuid())
  userId    String?
  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  channel   NotificationChannel @default(IN_APP)
  isRead    Boolean             @default(false)
  metadata  Json?
  createdAt DateTime            @default(now())

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        String   // "PRODUCT_CREATED", "STOCK_ADJUSTMENT", "PAYMENT_VERIFIED", etc.
  entityType    String   // "Product", "Order", "Quote", "Payment", "User", "Settings"
  entityId      String
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ==========================================
// 12. CONFIGURABLE SITE & DOMAIN SETTINGS
// ==========================================

model SiteSettings {
  id                       String   @id @default("default")
  brandName                String   @default("ALPHA TECH")
  supportEmail             String   @default("contact@alphatech.pk")
  supportPhone             String   @default("+92 300 0000000")
  whatsappNumber           String   @default("+923000000000")
  address                  String   @default("Plot 12-B, Industrial Area, Sector I-9/2, Islamabad, Pakistan")
  currency                 String   @default("PKR")
  lowStockThresholdDefault Int      @default(5)
  socialLinks              Json?
  updatedAt                DateTime @updatedAt
}

model PaymentSettings {
  id                  String   @id @default("default")
  codEnabled          Boolean  @default(true)
  codMaxAmount        Decimal  @default(50000) @db.Decimal(12, 2)
  bankTransferEnabled Boolean  @default(true)
  bankName            String   @default("Meezan Bank Limited")
  bankAccountTitle    String   @default("ALPHA TECH ENGINEERING (PVT) LTD")
  bankIban            String   @default("PK00MEZN0001234567890123")
  jazzcashEnabled     Boolean  @default(true)
  jazzcashNumber      String   @default("0300-1234567")
  easypaisaEnabled    Boolean  @default(true)
  easypaisaNumber     String   @default("0345-1234567")
  cardEnabled         Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model ShippingSettings {
  id                    String   @id @default("default")
  defaultOriginCity     String   @default("Lahore")
  defaultShippingFee    Decimal  @default(250) @db.Decimal(12, 2)
  freeShippingThreshold Decimal  @default(15000) @db.Decimal(12, 2)
  expressDeliveryFee    Decimal  @default(500) @db.Decimal(12, 2)
  codAllowed            Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}
